<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                
                <Button ToolTip="Відкрити" Margin="2" Width="60" Height="60">
                    <Image Source="D:\KPI\6 семестр\wpf\WpfApp1\icons\img1.png" />
                </Button>
                
                <Button ToolTip="Стерти" Margin="2" Width="60" Height="60">
                    <Image Source="D:\KPI\6 семестр\wpf\WpfApp1\icons\img2.png" />
                </Button>
                
                <Button ToolTip="Копіювати" Margin="2" Width="60" Height="60">
                    <Image Source="D:\KPI\6 семестр\wpf\WpfApp1\icons\img3.png" />
                </Button>
                
                <Button ToolTip="Вставити" Margin="2" Width="60" Height="60">
                    <Image Source="D:\KPI\6 семестр\wpf\WpfApp1\icons\img4.png" />
                </Button>
                
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5">
            
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>
                
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Button DockPanel.Dock="Bottom" Content="OK" Width="50" HorizontalAlignment="Center"/>
                </DockPanel>
            </Grid>
            
        </Border>
        
    </Grid>
</Window>