<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
<Canvas Background="Cyan">
    
    <Label Canvas.Left="20" Canvas.Top="20" Content="Label"/>
    
    <TextBox Canvas.Left="40" Canvas.Top="40" Text="text" Padding="2" Background="White"/>
    
    <Button Canvas.Left="60" Canvas.Top="60" Content="button" Padding="4,2"/>

</Canvas>
</Window>
